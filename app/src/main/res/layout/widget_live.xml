<?xml version="1.0" encoding="utf-8"?>
<!-- Olympia's live widget: the match on now, else the latest big moment, else the next fixture. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">
    <TextView
        android:id="@+id/live_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_accent"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Olympia" />
    <TextView
        android:id="@+id/live_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_ink"
        android:textSize="22sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="No match today" />
    <TextView
        android:id="@+id/live_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_ink2"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="" />
    <TextView
        android:id="@+id/live_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_ink2"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
