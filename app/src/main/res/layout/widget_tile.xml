<?xml version="1.0" encoding="utf-8"?>
<!-- One Hestia switch: its name and On, Off or Offline. Lit tiles are saffron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    android:minHeight="40dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/widget_tile_off">
    <TextView
        android:id="@+id/tile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/tile_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink2"
        android:textSize="11sp"
        android:maxLines="1" />
</LinearLayout>
