<?xml version="1.0" encoding="utf-8"?>
<!-- One row: a status dot or his own task's tick box, the text, and a short meta on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="27dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
        android:id="@+id/row_mark"
        android:layout_width="22dp"
        android:layout_height="27dp"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="4dp"
        android:scaleType="center" />
    <TextView
        android:id="@+id/row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/widget_ink"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/row_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/widget_ink2"
        android:textSize="12sp"
        android:maxLines="1" />
</LinearLayout>
