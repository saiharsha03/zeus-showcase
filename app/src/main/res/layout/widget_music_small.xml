<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing in one row: the track on the left, play or pause and next on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="10dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/w_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_ink2"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <ImageView
        android:id="@+id/m_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:scaleType="center"
        android:background="@drawable/widget_round_saffron"
        android:src="@drawable/widget_ic_play"
        android:contentDescription="Play" />
    <ImageView
        android:id="@+id/m_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:scaleType="center"
        android:background="@drawable/widget_round_raised"
        android:src="@drawable/widget_ic_next"
        android:contentDescription="Next track" />
</LinearLayout>
