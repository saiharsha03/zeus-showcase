<?xml version="1.0" encoding="utf-8"?>
<!-- Delphi quick ask: no data, only the way in. The field opens Delphi; the mic opens Athena listening. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_bg">
    <TextView
        android:id="@+id/w_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:textColor="@color/widget_accent"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:maxLines="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/d_field"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:background="@drawable/widget_pill"
            android:textColor="@color/widget_ink2"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <ImageView
            android:id="@+id/d_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:scaleType="center"
            android:background="@drawable/widget_round_saffron"
            android:src="@drawable/widget_ic_mic"
            android:contentDescription="Ask Athena by voice" />
    </LinearLayout>
</LinearLayout>
